# 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 실제 키를 넣어 주세요. (이 파일엔 키를 넣지 않아요!)

# 날씨 (weather.py, weather_proj.py) — 발급: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# 환율 (ratecalc.py) — 발급: https://app.exchangerate-api.com/dashboard
EXCHANGERATE_API_KEY=

# AI 챗봇 (chat.py) — 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
